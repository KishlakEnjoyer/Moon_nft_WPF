<Window x:Class="Moon_nft_application.Elements.EditProfileModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать профиль"
        Height="500" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#FF303030">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактировать профиль" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="White"/>

        <Label Grid.Row="1" Foreground="White" Content="Текущий пароль:"/>
        <PasswordBox x:Name="CurrentPasswordBox" Foreground="White" Grid.Row="2" Margin="0,0,0,10"/>

        <Label Grid.Row="3" Content="Новый никнейм (необязательно):" Foreground="White"/>
        <TextBox x:Name="NewNicknameBox" Grid.Row="4" Margin="0,0,0,10" Foreground="White"/>

        <Label Grid.Row="5" Content="Новый пароль (необязательно):" Foreground="White"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="6" Margin="0,0,0,10" Foreground="White"/>

        <Label Grid.Row="7" Content="Подтвердите новый пароль:" Foreground="White"/>
        <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Row="8" Margin="0,0,0,20" Foreground="White"/>

        <Button x:Name="SaveButton" Grid.Row="9" Content="Сохранить" Click="SaveButton_Click" Margin="0,0,0,5"/>
        <Button x:Name="CancelButton" Grid.Row="10" Content="Отмена" Click="CancelButton_Click"/>
    </Grid>
</Window>