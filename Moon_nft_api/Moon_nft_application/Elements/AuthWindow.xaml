<Window x:Class="Moon_nft_application.Elements.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Авторизация" Height="400" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF151515"
        Foreground="WhiteSmoke">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="title" Text="Войти в аккаунт"
                   FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBox x:Name="lbox" Grid.Row="1" 
                 md:HintAssist.Hint="Email" 
                 Margin="0,0,0,0" Padding="10"/>

        <PasswordBox x:Name="pbox" Grid.Row="2" 
                     md:HintAssist.Hint="Пароль" 
                     Margin="0,0,0,0" Padding="10"/>

        <Button x:Name="sbutton" Content="Войти" Grid.Row="3"
                Click="SubmitButton_Click" 
                 Background="#333" Foreground="White" VerticalAlignment="Stretch"/>

        <TextBlock Grid.Row="4" Text="Нет аккаунта?"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <Button x:Name="SwitchModeButton" Content="Зарегистрироваться" Grid.Row="5"
                Click="SwitchModeButton_Click"
                Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"/>
        
    </Grid>
</Window>