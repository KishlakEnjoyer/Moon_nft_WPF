<Window x:Class="Moon_nft_application.Elements.AddCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Moon_nft_application.Elements"
        mc:Ignorable="d"
        Title="AddCollectionWindow" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#FF303030">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название:" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
        <TextBox Grid.Row="1" x:Name="nameTextBox" FontSize="14" Height="30" Margin="0,0,0,15" Foreground="White"/>

        <TextBlock Grid.Row="2" Text="Изображение:" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="browseImageButton" Content="Выбрать изображение" 
                    Click="BrowseImageButton_Click" 
                    Width="150" Height="30" Margin="0,0,10,0"/>
            <Border BorderBrush="Gray" BorderThickness="1" Width="100" Height="100">
                <Image x:Name="previewImage" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Лимит:" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
        <TextBox Grid.Row="5" x:Name="limitTextBox" FontSize="14" Height="30" Margin="0,0,0,15" Foreground="White"/>

        <TextBlock Grid.Row="6" Text="Доступно:" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
        <TextBox Grid.Row="7" x:Name="countTextBox" FontSize="14" Height="30" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="8" Text="Цена:" FontSize="16" Margin="0,0,0,5" Foreground="White"/>
        <TextBox Grid.Row="9" x:Name="priceTextBox" FontSize="14" Height="30" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="saveButton" Content="Сохранить" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="SaveButton_Click" Background="Green" Foreground="White"/>
            <Button x:Name="cancelButton" Content="Отмена" Width="100" Height="35" 
                    Click="CancelButton_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
