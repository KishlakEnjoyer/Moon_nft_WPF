<UserControl x:Class="Moon_nft_application.Elements.PresentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Moon_nft_application.Elements" 
             xmlns:local1="clr-namespace:Moon_nft_application.Scripts"
             mc:Ignorable="d" 
             d:DesignHeight="247" d:DesignWidth="170">
    <UserControl.Resources>
        <local1:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageConverter"/>
    </UserControl.Resources>
    <Border CornerRadius="12" Background="#FF1A1A1A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="150"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    CornerRadius="12">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding IdPresentNavigation.ImagePresent, Converter={StaticResource ByteArrayToImageConverter}}"/>
                </Border.Background>
            </Border>
            

            <TextBlock x:Name="lotPresentName"
                       Grid.Row="2"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       FontFamily="{StaticResource AgdasimaReg}"
                       FontSize="20"
                       Foreground="WhiteSmoke"
                       Text="{Binding IdPresentNavigation.IdPresentCollectionNavigation.NamePresentCollection}"/>

            <TextBlock x:Name="lotPresentID"
           Grid.Row="3"
           Grid.Column="1"
           VerticalAlignment="Center"
           HorizontalAlignment="Left"
           FontFamily="{StaticResource AgdasimaReg}"
           FontSize="16"
           Foreground="WhiteSmoke"
           Text="{Binding IdPresentNavigation.displayNum}"/>

            <Grid Grid.Row="4"
                  Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="91"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0" 
                    Background="#FF1689FE"
                    CornerRadius="4.5"
                    x:Name="BuyButton"
                    Cursor="Cross"
                    MouseLeftButtonDown="BuyButton_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF011833"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="#FF1689FE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                                Height="20"
                                Width="50"
                                HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/TonWhite.png" Height="20"/>
                        <TextBlock FontFamily="{StaticResource AgdasimaReg}"
                                   FontSize="16"
                                   Text="{Binding PriceLot}"
                                   Foreground="WhiteSmoke"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#FF4F4F4F"
                        CornerRadius="4.5"
                        x:Name="CartButton"
                        Cursor="Hand"
                        MouseLeftButtonDown="CartButton_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF848484"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="#FF4F4F4F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="/Resources/Icons/Shopping cart.png"
                           Height="18"
                           Width="18"/>
                </Border>
            </Grid>


        </Grid>
    </Border>
</UserControl>
