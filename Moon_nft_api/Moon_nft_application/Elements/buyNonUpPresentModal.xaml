<Window x:Class="Moon_nft_application.Elements.buyNonUpPresentModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Moon_nft_application.Elements"
             xmlns:local1="clr-namespace:Moon_nft_application.Scripts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
        Background="Transparent" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        AllowsTransparency="True">
    <Window.Resources>
        <local1:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>
    <Border Background="Transparent" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="#FF303030" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и кнопка закрытия -->
                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Неулучшенные подарки" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="White"/>
                    <Button x:Name="CloseButton" Grid.Column="1" FontSize="16" 
                            Background="Red" BorderBrush="Transparent" 
                            Foreground="White" Width="30" Height="30" 
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="CloseButton_Click"/>
                </Grid>

                <ListView x:Name="PresentsListView" 
          Grid.Row="1"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="№" Width="80" DisplayMemberBinding="{Binding IdPresentCollections}"/>
                            <GridViewColumn Header="Изображение" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePresentcollections, Converter={StaticResource ByteArrayToImageConverter}}"
                               Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Название" Width="150" DisplayMemberBinding="{Binding NamePresentCollection}" />
                            <GridViewColumn Header="Доступно" Width="150" DisplayMemberBinding="{Binding AvailableCount}" />
                            <GridViewColumn Header="Всего" Width="120" DisplayMemberBinding="{Binding LimitPresentCollection}" />
                            <GridViewColumn Header="Цена" Width="120" DisplayMemberBinding="{Binding PricePresentCollection}" />
                            <!-- Новый столбец с кнопкой -->
                            <GridViewColumn Header="Действие" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Купить" 
                                Click="buyNonUpPresentBtn_Click"
                                Tag="{Binding IdPresentCollections}"
                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Border>
</Window>