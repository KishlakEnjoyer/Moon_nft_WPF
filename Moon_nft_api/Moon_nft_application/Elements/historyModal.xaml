<Window x:Class="Moon_nft_application.Elements.historyModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Moon_nft_application.Elements"
        xmlns:local1="clr-namespace:Moon_nft_application.Scripts"
        mc:Ignorable="d"
        Title="historyModal" d:DesignHeight="450" d:DesignWidth="1000" Background="Transparent" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
AllowsTransparency="True" Loaded="Window_Loaded">
    <Window.Resources>
        <local1:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>
    <Border Background="Transparent" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="#FF303030" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и кнопка закрытия -->
                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="История транзакций" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="White"/>
                    <ComboBox x:Name="cbox" Grid.Column="1" Width="200" FontSize="20" Foreground="White" SelectionChanged="ComboBox_SelectionChanged"
                              Margin="30 0">
                        <ComboBoxItem Content="Ваши покупки" Foreground="White"/>
                        <ComboBoxItem Content="Ваши продажи" Foreground="White"/>
                    </ComboBox>
                    <Button x:Name="CloseButton" Grid.Column="2" FontSize="16" 
                        Background="Red" BorderBrush="Transparent" 
                        Foreground="White" Width="30" Height="30" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click"/>
                </Grid>

                <ListView x:Name="transactionsListView" 
      Grid.Row="1"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Изображение" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePresent, Converter={StaticResource ByteArrayToImageConverter}}"
                           Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Название" Width="150" DisplayMemberBinding="{Binding CollectionPresent}" />
                            <GridViewColumn Header="Номер" Width="150" DisplayMemberBinding="{Binding displayNum}" />
                            <GridViewColumn x:Name="salerBuyerColumn" Header="Продавец" Width="120" DisplayMemberBinding="{Binding NameSaler}" />
                            <GridViewColumn Header="Цена" Width="120" DisplayMemberBinding="{Binding SumTransaction, StringFormat='-{0} TON'}"/>
                            <GridViewColumn Header="Дата покупки" Width="150" DisplayMemberBinding="{Binding DateTransaction}"/>
                            <GridViewColumn Header="Чек" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Чек" 
                                Click="Button_Click" 
                                Tag="{Binding IdTransaction}" 
                                Width="60" Height="25"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ListView x:Name="salesListView" 
Grid.Row="1"
ScrollViewer.HorizontalScrollBarVisibility="Disabled"
ScrollViewer.VerticalScrollBarVisibility="Auto"
Foreground="White" Visibility="Collapsed">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Изображение" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePresent, Converter={StaticResource ByteArrayToImageConverter}}"
                     Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Название" Width="150" DisplayMemberBinding="{Binding CollectionPresent}" />
                            <GridViewColumn Header="Номер" Width="150" DisplayMemberBinding="{Binding displayNum}" />
                            <GridViewColumn Header="Покупатель" Width="120" DisplayMemberBinding="{Binding NameBuyer}" />
                            <GridViewColumn Header="Цена" Width="120" DisplayMemberBinding="{Binding SumTransaction, StringFormat='+{0} TON'}"/>
                            <GridViewColumn Header="Дата покупки" Width="150" DisplayMemberBinding="{Binding DateTransaction}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Border>
</Window>
