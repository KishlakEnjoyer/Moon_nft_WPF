<Page x:Class="Moon_nft_application.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Moon_nft_application.Pages"
      xmlns:local1="clr-namespace:Moon_nft_application.Scripts"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1800"
      Title="AdminPage" Loaded="Page_Loaded">
    <Page.Resources>
        <local1:ByteArrayToImageSourceConverter x:Key="zxc"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0"
                HorizontalAlignment="Left"
                Content="Добавить коллекцию"
                FontSize="30"
                Height="60"
                x:Name="addCollectionBtn"
                Click="addCollectionBtn_Click"/>
        <ComboBox Grid.Row="0" HorizontalAlignment="Right" x:Name="cbox"
                  FontSize="34" Foreground="White"
                  SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Content="Транзакции" Foreground="Black"/>
            <ComboBoxItem Content="Коллекции" Foreground="Black"/>
            <ComboBoxItem Content="Лоты" Foreground="Black"/>
        </ComboBox>
        <ListView x:Name="collectionsListView" 
                  Grid.Row="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Standard"
                  Foreground="White"
                  HorizontalAlignment="Stretch"
                  Visibility="Collapsed">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" Width="150" DisplayMemberBinding="{Binding IdPresentCollections}"/>
                    <GridViewColumn Header="Изображение" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePresentcollections, Converter={StaticResource zxc}}"
                     Width="150" Height="150" Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название" Width="400" DisplayMemberBinding="{Binding NamePresentCollection}" />
                    <GridViewColumn Header="Доступно" Width="300" DisplayMemberBinding="{Binding AvailableCount}" />
                    <GridViewColumn Header="Всего" Width="300" DisplayMemberBinding="{Binding LimitPresentCollection}" />
                    <GridViewColumn Header="Цена" Width="200" DisplayMemberBinding="{Binding PricePresentCollection}" />
                </GridView>
            </ListView.View>
        </ListView>

        <ListView x:Name="lotsListView" 
          Grid.Row="2"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.CanContentScroll="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Standard"
          Foreground="White"
          HorizontalAlignment="Stretch"
                  Visibility="Collapsed">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" Width="100" DisplayMemberBinding="{Binding IdLot}"/>
                    <GridViewColumn Header="Изображение" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePresent, Converter={StaticResource zxc}}"
             Width="150" Height="150" Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="id Продавца" Width="300" DisplayMemberBinding="{Binding IdSaler}" />
                    <GridViewColumn Header="Ник Продавца" Width="300" DisplayMemberBinding="{Binding SalerNickname}" />
                    <GridViewColumn Header="Цена" Width="300" DisplayMemberBinding="{Binding PriceLot}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
