<Page x:Class="Moon_nft_application.Pages.catalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Moon_nft_application.Pages"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local1="clr-namespace:Moon_nft_application.Elements"
      mc:Ignorable="d" 
      d:DesignHeight="1400" d:DesignWidth="1080"
      Title="catalogPage" Loaded="Page_Loaded" HorizontalAlignment="Stretch">

    <Grid Margin="0 10 0 0" ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="30" 
    Background="#FF1A1A1A"
    Padding="10 0" Grid.Column="1" Margin="10">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/Icons/Search.png" 
               Height="30"
               Width="30"/>
                <TextBox x:Name="searchBar"
             md:HintAssist.Hint="Искать подарки" Style="{StaticResource MaterialDesignFilledTextBox}"
             Background="Transparent"
             BorderBrush="Transparent"
             VerticalAlignment="Center"
             HorizontalAlignment="Stretch"
             Foreground="#FF4F4F4F"
             MinWidth="250"
             Width="400"
             FontSize="20"
             Margin="10 0" 
             SelectionBrush="#FFACACAC"
             TextChanged="searchBar_TextChanged"/>
            </StackPanel>
        </Border>
        <Border CornerRadius="30" 
Background="#FF1A1A1A"
Padding="0" HorizontalAlignment="Stretch" Grid.Column="2" Margin="10">
            <ComboBox x:Name="filterVid"
          md:HintAssist.Hint="Вид"
          Width="180"
          FontSize="20"
          Foreground="White"
          Background="#FF1A1A1A"
          Margin="10 0"
          DisplayMemberPath="NamePresentCollection" SelectionChanged="filterVid_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <!-- Опционально: убрать выделение при наведении -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Border>

        <Border CornerRadius="30" 
Background="#FF1A1A1A"
Padding="0" HorizontalAlignment="Stretch"
                Grid.Column="3"
                Margin="10">
            <ComboBox x:Name="filterModel"
                      Width="180"
                      md:HintAssist.Hint="Модель"  
                      FontSize="20"    
                      Foreground="WhiteSmoke"
                          Margin="10 0"
                           DisplayMemberPath="NameModel"
                      SelectionChanged="filterModel_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Background="{TemplateBinding Background}" 
                Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            </Border>

            <Border CornerRadius="30" 
Background="#FF1A1A1A"
Padding="0" HorizontalAlignment="Stretch"
                    Grid.Column="4"
                    Margin="10">
            <ComboBox x:Name="filterBG"
          Width="180"
          md:HintAssist.Hint="Фон"  
          FontSize="20"    
          Foreground="WhiteSmoke"
              Margin="10 0"
               DisplayMemberPath="NameBackground"
                      SelectionChanged="filterBG_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Background="{TemplateBinding Background}" 
    Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Border>

            <Border CornerRadius="30" 
Background="#FF1A1A1A"
Padding="0" HorizontalAlignment="Stretch"
                    Grid.Column="5"
                    Margin="10">
            <ComboBox x:Name="filterSymbol"
      Width="180"
      md:HintAssist.Hint="Узор"  
      FontSize="20"    
      Foreground="WhiteSmoke"
          Margin="10 0"
           DisplayMemberPath="NameSymbol"
            SelectionChanged="filterSymbol_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Background="{TemplateBinding Background}" 
Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Border>

        <Border CornerRadius="30" 
Background="#FF1A1A1A"
Padding="0" HorizontalAlignment="Stretch"
                    Grid.Column="6"
                    Margin="10">
            <ComboBox x:Name="filterSort"
            Width="180"
            md:HintAssist.Hint="Сортировка"  
            FontSize="20"    
            Foreground="WhiteSmoke"
            Margin="10 0"
                      SelectedIndex="0"
                      SelectionChanged="filterSort_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border Background="{TemplateBinding Background}" 
Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="По умолчанию"/>
                <ComboBoxItem Content="По цене ↓"/>
                <ComboBoxItem Content="По цене ↑"/>
                <ComboBoxItem Content="По номеру подарка ↓"/>
                <ComboBoxItem Content="По номеру подарка ↑"/>
            </ComboBox>
        </Border>
        <ItemsControl x:Name="ItemsList"
      ItemsSource="{Binding AllLots}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6">
            <!-- Привязка к коллекции в ViewModel -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Сетка с 6 колонками -->
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Используем ваш UserControl -->
                    <local1:PresentCard Margin="5" Width="170" Height="247"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
